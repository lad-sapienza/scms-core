---
import "../styles/global.css"
import SEO from "@lad-sapienza/scms-core/components/SEO/SEO.astro"
import BSNavbar from "@lad-sapienza/scms-core/components/BSNavbar"
import ThemeToggle from "@lad-sapienza/scms-core/components/ThemeToggle"
import { siteMetadata } from "../user.config.mjs"

interface Props {
  title?: string
  description?: string
}

const { title = siteMetadata.title, description = siteMetadata.description } =
  Astro.props

const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} siteMetadata={siteMetadata} />
    <slot name="head" />
  </head>

  <body class="d-flex flex-column min-vh-100">
    <BSNavbar
      client:load
      menuItems={[]}
      currentPath={currentPath}
      cssClasses={{
        nav: "bg-body-tertiary navbar-expand-md sticky-top shadow-sm border-bottom",
        ul: "ms-auto mb-2 mb-md-0",
        li: "text-center fw-medium",
      }}
      brand={{
        text: siteMetadata.title,
        link: "/",
        cssClasses: "fw-bold",
      }}
    />
    <ThemeToggle client:load />

    <main
      class="container flex-grow-1"
      style="padding-top: 6rem; padding-bottom: 3rem;"
    >
      <slot />
    </main>

    <footer class="py-4 mt-auto border-top">
      <div class="container text-center text-muted small">
        Built with <a href="https://github.com/lad-sapienza/scms-core" target="_blank" rel="noreferrer">s:CMS</a>
      </div>
    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      defer
      is:inline></script>
  </body>
</html>
